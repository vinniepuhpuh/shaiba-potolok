{
	# Только HTTP/1.1 и HTTP/2: QUIC (HTTP/3) у части мобильных операторов работает с перебоями
	servers {
		protocols h1 h2
	}
}

gmhockey.ru, www.gmhockey.ru, {$DOMAIN} {
	# json и html сжимаются, сохранения (уже gzip) — нет
	encode gzip
	log {
		output stdout
		format json
	}

	@backend path /api/* /bot/* /admin /privacy
	handle @backend {
		reverse_proxy api:3000
	}

	# Сама игра: файлы из server/www (туда deploy.sh копирует index.html из корня репозитория)
	handle {
		root * /srv/game
		header Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}

	header -Server
}
