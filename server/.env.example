# Этот файл — образец. setup.sh сам создаёт .env с этими полями.
# Файл .env хранится только на сервере и в git не попадает.

# Адрес сервера: свой домен (api.example.ru) или бесплатный вида 1-2-3-4.sslip.io
DOMAIN=

# Токен бота от @BotFather (тот же, что в секретах GitHub)
BOT_TOKEN=

# Случайные строки, setup.sh генерирует их сам
DB_PASSWORD=
SESSION_SECRET=
ADMIN_KEY=
BOT_WEBHOOK_PATH=
BOT_WEBHOOK_SECRET=

# Откуда разрешены запросы (адрес игры)
CORS_ORIGINS=https://shaiba-potolok.vercel.app
GAME_URL=https://shaiba-potolok.vercel.app
